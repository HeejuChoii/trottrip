# Claude API (일정 생성·재생성·챗봇). 비워 두면 규칙 기반 일정/답변으로 동작
ANTHROPIC_API_KEY=
# 선택: 일정 생성용 상위 모델 (기본 claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# 선택: 챗봇 대체·이유 분류용 작은 모델 (기본 claude-haiku-5-5)
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
# Claude API 예산(USD). 누적 사용량이 넘으면 새 일정은 규칙 기반으로 만든다. 해커톤 크레딧 $50
ANTHROPIC_BUDGET_USD=45
# trip당 물어보기 횟수 (PRD 9장)
CHAT_LIMIT_PER_TRIP=30

# Supabase (비워 두면 로컬 개발용 .data/db.json 파일 저장소 사용 — Vercel에서는 반드시 설정)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 카카오 JavaScript 키 (공유 + 지도). 카카오 디벨로퍼스에 배포 도메인 등록 필요
NEXT_PUBLIC_KAKAO_JS_KEY=

# 콘서트립 공개 읽기 API 기본 주소. GET {CONCERTRIP_API_URL}/concerts/{id}/places
CONCERTRIP_API_URL=
# 선택: 콘서트립 API 인증 헤더 값 (Bearer 토큰 등)
CONCERTRIP_API_TOKEN=

# /admin 비밀번호
ADMIN_PASSWORD=

# 배포 주소 (OG·공유 링크 절대경로용). 예: https://trottrip.vercel.app
NEXT_PUBLIC_SITE_URL=

# 물어보기 챗봇: Render의 Croche 서버 (render.yaml). 비우면 Claude → 규칙 기반 답변
AGENT_URL=
# Render와 같은 값 (예: openssl rand -hex 32)
AGENT_SHARED_SECRET=

# 카카오 로컬 API (공연장 주변 식당·카페 불러오기, 좌표 찾기). 카카오 디벨로퍼스 같은 앱의 "REST API 키"
KAKAO_REST_API_KEY=

